-- A deliberately unoptimized edit-distance reference: compare Unicode
-- characters using every dynamic-programming cell, without trigram filtering,
-- byte-length shortcuts, an automaton, or any pg_fts function.
CREATE FUNCTION lp_edit_distance(a text, b text) RETURNS integer
LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE
  previous integer[] := ARRAY(SELECT generate_series(0, char_length(b)));
  current_row integer[];
  i integer;
  j integer;
BEGIN
  FOR i IN 1..char_length(a) LOOP
    current_row := ARRAY[i];
    FOR j IN 1..char_length(b) LOOP
      current_row[j+1] := least(previous[j+1] + 1, current_row[j] + 1,
        previous[j] + (substr(a,i,1) <> substr(b,j,1))::integer);
    END LOOP;
    previous := current_row;
  END LOOP;
  RETURN previous[char_length(b)+1];
END
$$;
SELECT lp_edit_distance('abxde','abcde') = 1 AS destroyed_trigrams,
       lp_edit_distance('chat',U&'ch\00E2t') = 1 AS unicode_substitution,
       lp_edit_distance(repeat('x',260),repeat('y',260)) = 260 AS long_mismatch;
 destroyed_trigrams | unicode_substitution | long_mismatch 
--------------------+----------------------+---------------
 t                  | t                    | t
(1 row)

-- Standalone and compound fuzzy queries must agree on accepted words.  The
-- >255-byte cases exceed the ASCII automaton's term capacity; k=255 and k=256
-- exercise its bounded-row limit.  The long all-y documents supply real misses.
WITH cases(name, word, distance) AS (VALUES
       ('accent_query', U&'ch\00E2t', 1),
       ('accent_candidate', 'chat', 1),
       ('lost_trigrams', 'abcde', 1),
       ('long_ascii', repeat('x',260), 1),
       ('distance_255', 'alpha', 255),
       ('distance_256', 'alpha', 256),
       ('unicode_insert', U&'\4EAC', 1),
       ('unicode_delete', U&'\6771\4EAC', 1),
       ('long_unicode', repeat(U&'\00E2',130), 1),
       ('unicode_boundary', repeat('a',254), 1)),
     vocabulary AS (SELECT DISTINCT unnest(words) AS word FROM lp_docs),
     accepted AS MATERIALIZED (
       SELECT c.name, c.word || '~' || c.distance AS query_text,
              jsonb_build_array('terms', jsonb_agg(v.word ORDER BY v.word)) AS expr
       FROM cases c CROSS JOIN vocabulary v
       WHERE lp_edit_distance(c.word, v.word) <= c.distance
       GROUP BY c.name, c.word, c.distance),
     forms(kind) AS (VALUES ('standalone'), ('or'), ('within'), ('exact'))
INSERT INTO lp_queries
SELECT a.name || '_' || f.kind,
       to_ftsquery(CASE f.kind
         WHEN 'standalone' THEN a.query_text
         WHEN 'or' THEN '(' || a.query_text || ' OR dog)'
         WHEN 'within' THEN a.query_text || ' w/1 beta'
         WHEN 'exact' THEN a.query_text || ' <-> beta' END),
       CASE f.kind
         WHEN 'standalone' THEN a.expr
         WHEN 'or' THEN jsonb_build_array('or', a.expr, 'dog')
         WHEN 'within' THEN jsonb_build_array('w', 1, a.expr, 'beta')
         WHEN 'exact' THEN jsonb_build_array('e', 1, a.expr, 'beta') END,
       NULL
FROM accepted a CROSS JOIN forms f;
CREATE TABLE lp_truth AS
SELECT q.name, d.id FROM lp_queries q CROSS JOIN lp_docs d
WHERE EXISTS (SELECT FROM lp_occurrences(d.words, d.labels, q.expr));
-- Every query has real matches AND rejects some documents; 0 = 0 cannot pass.
SELECT count(*) AS queries,
       bool_and(hits > 0 AND hits < (SELECT count(*) FROM lp_docs)) AS nontrivial
FROM (SELECT q.name, count(t.id) AS hits FROM lp_queries q
      LEFT JOIN lp_truth t USING (name) GROUP BY q.name) AS counts;
