-- Complete spans, rather than one endpoint, define unordered proximity.
-- Enumerate every five-token document over four words, plus focused expansion
-- cases outside that alphabet.  The reference below
-- tries EVERY pair of occurrences recursively using SQL cross joins; it never
-- calls pg_fts, consults an index, or uses the implementation's ordered merge.
-- Both shorter and longer occurrences with the same endpoint must survive.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pg_fts;
SET max_parallel_workers_per_gather = 0;
SET jit = off;
CREATE FUNCTION lp_occurrences(words text[], labels text[], expr jsonb)
RETURNS TABLE (first_pos integer, last_pos integer)
LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
  IF jsonb_typeof(expr) = 'string' THEN
    RETURN QUERY SELECT p::integer, p::integer
      FROM unnest(words) WITH ORDINALITY AS w(word, p)
      WHERE word = expr #>> '{}';
  ELSIF expr->>0 = 'weight' THEN
    RETURN QUERY SELECT p::integer, p::integer
      FROM unnest(words) WITH ORDINALITY AS w(word, p)
      WHERE word = expr->>1 AND strpos(expr->>2, labels[p]) > 0;
  ELSIF expr->>0 = 'terms' THEN
    RETURN QUERY SELECT p::integer, p::integer
      FROM unnest(words) WITH ORDINALITY AS w(word, p)
      WHERE word IN (SELECT jsonb_array_elements_text(expr->1));
  ELSIF expr->>0 = 'or' THEN
    RETURN QUERY
      SELECT * FROM lp_occurrences(words, labels, expr->1)
      UNION
      SELECT * FROM lp_occurrences(words, labels, expr->2);
  ELSIF expr->>0 = 'and' THEN
    RETURN QUERY SELECT 0, 0
      WHERE EXISTS (SELECT FROM lp_occurrences(words, labels, expr->1))
        AND EXISTS (SELECT FROM lp_occurrences(words, labels, expr->2));
  ELSE
    RETURN QUERY
      SELECT DISTINCT least(l.first_pos, r.first_pos),
                      greatest(l.last_pos, r.last_pos)
      FROM lp_occurrences(words, labels, expr->2) AS l
      CROSS JOIN lp_occurrences(words, labels, expr->3) AS r
      WHERE CASE expr->>0
        WHEN 'w' THEN
          r.first_pos - l.last_pos BETWEEN 1 AND (expr->>1)::integer
          OR l.first_pos - r.last_pos BETWEEN 1 AND (expr->>1)::integer
        WHEN 'e' THEN r.first_pos - l.last_pos = (expr->>1)::integer
        WHEN 'p' THEN r.last_pos - l.last_pos BETWEEN 1 AND (expr->>1)::integer
        ELSE false END;
  END IF;
END
$$;
CREATE TABLE lp_docs AS
SELECT n + 1 AS id,
       ARRAY(SELECT (ARRAY['alpha','alphi','beta','gamma'])[1 + ((n >> (2*p)) & 3)]
             FROM generate_series(0, 4) AS p ORDER BY p) AS words,
       ARRAY['A','B','C','D','A'] AS labels
FROM generate_series(0, 1023) AS n;
