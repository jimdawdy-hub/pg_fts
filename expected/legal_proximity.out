COPY (SELECT name, q FROM lp_queries ORDER BY name)
  TO '/tmp/pg_fts_legal_proximity.bin' WITH (FORMAT binary);
CREATE TABLE lp_binary (name text, q ftsquery);
COPY lp_binary FROM '/tmp/pg_fts_legal_proximity.bin' WITH (FORMAT binary);
SELECT count(*) AS binary_queries,
       bool_and(ftsquery_send(a.q) = ftsquery_send(b.q)) AS binary_roundtrip
FROM lp_queries a JOIN lp_binary b USING (name);
 binary_queries | binary_roundtrip 
----------------+------------------
             89 | t
(1 row)

