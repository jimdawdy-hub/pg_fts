-- Adaptive ranked scans recompute top-k at larger k.  Every score and rank
-- in the first batch must be identical to the full pass, including tied docs.
WITH qs(name, q) AS (
  VALUES ('four_leaf', (SELECT q FROM lp_queries WHERE name = 'phrase_or')),
         ('three_leaf', 'alpha | beta | gamma'::ftsquery)),
small AS MATERIALIZED (
  SELECT qs.name, r.ctid, r.score,
         row_number() OVER (PARTITION BY qs.name ORDER BY r.score DESC, r.ctid) AS ord
  FROM qs, LATERAL fts_search('lp_on_idx', qs.q, 100) r),
all_ranked AS MATERIALIZED (
  SELECT qs.name, r.ctid, r.score,
         row_number() OVER (PARTITION BY qs.name ORDER BY r.score DESC, r.ctid) AS ord
  FROM qs, LATERAL fts_search('lp_on_idx', qs.q, 2048) r)
SELECT s.name, count(*) AS first_page,
       bool_and(s.ctid = a.ctid AND s.score = a.score) AS exact_prefix
FROM small s JOIN all_ranked a USING (name, ord)
GROUP BY s.name ORDER BY s.name;
    name    | first_page | exact_prefix 
------------+------------+--------------
 four_leaf  |        100 | t
 three_leaf |        100 | t
(2 rows)

RESET enable_seqscan;
RESET enable_bitmapscan;
-- Native PostgreSQL defines exact phrase distance, including zero and nested
-- phrases.  Exercise both our text parser and conversion from native tsquery.
SELECT count(*) AS native_exact_mismatches
FROM lp_queries q CROSS JOIN lp_docs d
WHERE q.native IS NOT NULL AND
  ((d.v @@ q.native) IS DISTINCT FROM (to_ftsdoc(d.v) @@@ q.q)
   OR (d.v @@ q.native) IS DISTINCT FROM (to_ftsdoc(d.v) @@@ q.native::ftsquery));
 native_exact_mismatches 
-------------------------
                       0
(1 row)

WITH phrases(phrase) AS (VALUES ('breach of contract'), ('breach of the contract'),
                               ('the breach of contract is')),
     documents(body) AS (VALUES ('breach contract'), ('breach of contract'),
       ('breach of the contract'), ('breach arbitrary contract'),
       ('the breach of contract is'), ('contract breach'))
SELECT count(*) FILTER (WHERE to_tsvector('english', body) @@
                              phraseto_tsquery('english', phrase)) > 0 AS native_matches,
       count(*) FILTER (WHERE
         (to_ftsdoc('english', body) @@@ to_ftsquery('english', '"' || phrase || '"'))
         IS DISTINCT FROM
         (to_tsvector('english', body) @@ phraseto_tsquery('english', phrase)))
       AS stopword_gap_mismatches
FROM phrases CROSS JOIN documents;
 native_matches | stopword_gap_mismatches 
----------------+-------------------------
 t              |                       0
(1 row)

SELECT bool_and(ftsquery_send(q) = ftsquery_send(q::text::ftsquery)) AS text_roundtrip
FROM lp_queries;
