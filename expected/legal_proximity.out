CREATE TABLE lp_on (id integer, d ftsdoc) WITH (autovacuum_enabled = false);
CREATE TABLE lp_off (LIKE lp_on) WITH (autovacuum_enabled = false);
INSERT INTO lp_on SELECT id, to_ftsdoc(v) FROM lp_docs WHERE id <= 512;
INSERT INTO lp_off SELECT * FROM lp_on;
CREATE INDEX lp_on_idx ON lp_on USING fts(d) WITH (positions = on);
CREATE INDEX lp_off_idx ON lp_off USING fts(d) WITH (positions = off);
-- These rows are searched from the pending list before the explicit merge.
INSERT INTO lp_on SELECT id, to_ftsdoc(v) FROM lp_docs WHERE id > 512;
INSERT INTO lp_off SELECT id, to_ftsdoc(v) FROM lp_docs WHERE id > 512;
ANALYZE lp_on;
ANALYZE lp_off;
-- Each comparison is a complete ID set, not merely an equal count.  Test both
-- public ranking entry points with k larger than the entire corpus, so ranking
-- cannot hide false negatives by dropping them below a small requested limit.
CREATE FUNCTION lp_check(stage text) RETURNS integer LANGUAGE plpgsql AS $$
DECLARE
  query record;
  arm text;
  want integer[];
  got integer[];
  got_count bigint;
  checks integer := 0;
BEGIN
  FOR query IN SELECT * FROM lp_queries ORDER BY name LOOP
    SELECT array_agg(id ORDER BY id) INTO want FROM lp_truth WHERE name = query.name;
    SELECT array_agg(id ORDER BY id) INTO got FROM lp_docs
      WHERE to_ftsdoc(v) @@@ query.q;
    IF got IS DISTINCT FROM want THEN
      RAISE EXCEPTION '% direct mismatch: %', stage, query.name;
    END IF;
    checks := checks + 1;
    FOREACH arm IN ARRAY ARRAY['on', 'off'] LOOP
      EXECUTE format('SELECT array_agg(id ORDER BY id) FROM %I WHERE d @@@ $1', 'lp_' || arm)
        INTO got USING query.q;
      IF got IS DISTINCT FROM want THEN
        RAISE EXCEPTION '% scan % mismatch: %', stage, arm, query.name;
      END IF;
      got_count := fts_count(('lp_' || arm || '_idx')::regclass, query.q);
      IF got_count <> cardinality(want) THEN
        RAISE EXCEPTION '% count % mismatch: %', stage, arm, query.name;
      END IF;
      EXECUTE format('SELECT array_agg(d.id ORDER BY d.id) FROM '
        'fts_search($1, $2, 2048) r JOIN %I d ON d.ctid = r.ctid', 'lp_' || arm)
        INTO got USING ('lp_' || arm || '_idx')::regclass, query.q;
      IF got IS DISTINCT FROM want THEN
        RAISE EXCEPTION '% fts_search % mismatch: %', stage, arm, query.name;
      END IF;
      EXECUTE format('SELECT array_agg(id ORDER BY id) FROM '
        '(SELECT id FROM %I WHERE d @@@ $1 ORDER BY d <=> $1 LIMIT 2048) s', 'lp_' || arm)
        INTO got USING query.q;
      IF got IS DISTINCT FROM want THEN
        RAISE EXCEPTION '% ranked scan % mismatch: %', stage, arm, query.name;
      END IF;
      checks := checks + 4;
    END LOOP;
  END LOOP;
  RETURN checks;
END
$$;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
