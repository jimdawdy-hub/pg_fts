UPDATE lp_docs SET v =
  setweight(to_tsvector('simple', words[1]), 'A') ||
  setweight(to_tsvector('simple', words[2]), 'B') ||
  setweight(to_tsvector('simple', words[3]), 'C') ||
  setweight(to_tsvector('simple', words[4]), 'D') ||
  setweight(to_tsvector('simple', words[5]), 'A');
-- JSON expressions describe expected meaning independently of query parsing:
-- w = either order/nonoverlap, e = exact edge distance, p = ordered max gap.
-- The last column is PostgreSQL's own query for independent exact-phrase truth.
-- NEAR's historical right-nested endpoint behavior is tested separately from
-- the left-associative infix p/N spelling.
CREATE TABLE lp_queries (name text PRIMARY KEY, q ftsquery, expr jsonb, native tsquery);
